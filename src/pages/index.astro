---
import BlogItem from '@/components/blog-item.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { getRecentPosts } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

const blog = await getRecentPosts(SITE.featuredPostCount)

const socialLinks = [
  {
    href: 'https://github.com/alexkang',
    label: 'GitHub',
    icon: 'lucide:github',
  },
  {
    href: 'https://www.linkedin.com/in/alexkang',
    label: 'LinkedIn',
    icon: 'lucide:linkedin',
  },
  {
    href: 'mailto:alex@alexkang.com',
    label: 'Email',
    icon: 'lucide:mail',
  },
]
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  <section class="flex flex-col gap-y-8 py-8 sm:py-12">
    <div class="space-y-3">
      <h1
        class="max-w-2xl text-4xl leading-tight font-semibold text-balance sm:text-5xl"
      >
        Opinionated static blogging with a quiet surface and sharp edges.
      </h1>
    </div>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <Link
        href="/projects"
        class="bg-primary text-primary-foreground hover:bg-primary/90 group inline-flex h-9 items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:ring-[3px]"
      >
        Projects <span
          class="inline-block transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
      {
        socialLinks.map((link) => (
          <Link
            href={link.href}
            aria-label={link.label}
            title={link.label}
            class="border-input bg-background hover:bg-muted hover:text-foreground inline-flex size-9 items-center justify-center rounded-md border"
            external
          >
            <Icon name={link.icon} class="size-4" />
          </Link>
        ))
      }
    </div>
  </section>

  <section class="flex flex-col gap-y-4">
    <h2 class="font-medium">Recent Posts</h2>
    <ul class="flex flex-col">
      {
        blog.map((post) => (
          <li>
            <BlogItem entry={post} />
          </li>
        ))
      }
    </ul>
    <div class="flex justify-end">
      <Link
        href="/blog"
        class="text-muted-foreground hover:text-foreground group text-sm"
      >
        All posts <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
</Layout>
