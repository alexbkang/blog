---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { Icon } from 'astro-icon/components'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section>
    <div class="min-w-full">
      <div class="mb-6">
        <p class="mb-4">Software Engineer with experience in integration development and cloud solutions using Java, Spring, AWS, and Azure, with DevOps experience in Terraform and CI/CD automation. Focused on designing and delivering scalable and secure applications for enterprise environments.</p>
        <Link
          href="/"
          class="bg-primary/70 text-primary-foreground hover:bg-primary group inline-flex h-9 items-center justify-center gap-2 px-4 py-2 text-sm font-medium whitespace-nowrap"
        >
          <Icon name="lucide:file-text" class="size-3.5" />
          Resume
        </Link>
      </div>

      <hr class="border-border my-6" />

      <div class="prose">
        <p class="mt-0">
          To learn more about the philosophy behind this template, check out the
          following blog post: <Link
            href="/blog/the-state-of-static-blogs"
            underline>The State of Static Blogs in 2024</Link
          >.
        </p>

        <p>
          astro-erudite is an opinionated, unstyled static blogging template
          that prioritizes simplicity and performance, built with <Link
            href="https://astro.build"
            external
            underline>Astro</Link
          >, <Link href="https://tailwindcss.com" external underline
            >Tailwind</Link
          >, and <Link href="https://ui.shadcn.com" external underline
            >shadcn/ui</Link
          >. It provides a clean foundation for your content while being
          extremely easy to customize.
        </p>
      </div>
    </div>
  </section>
</Layout>
