---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import ProjectCard from '@/components/project-card.astro'
import Layout from '@/layouts/layout.astro'
import { getAllProjects } from '@/lib/data-utils'

const projects = await getAllProjects()
const projectsByCategory = projects.reduce(
  (acc, project) => {
    const category = project.data.category ?? 'Projects'
    ;(acc[category] ??= []).push(project)
    return acc
  },
  {} as Record<string, typeof projects>,
)
const categories = Object.entries(projectsByCategory)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Projects" />
  <Breadcrumbs items={[{ label: 'Projects', icon: 'lucide:folder-kanban' }]} />

  <section class="flex flex-col gap-y-4">
    {
      categories.length === 1 && categories[0][0] === 'Projects' ? (
        <ul class="flex flex-col gap-4">
          {categories[0][1].map((project) => (
            <ProjectCard project={project} />
          ))}
        </ul>
      ) : (
        categories.map(([category, categoryProjects]) => (
          <section class="flex flex-col gap-y-2">
            <h2 class="text-lg font-medium">{category}</h2>
            <ul class="flex flex-col gap-4">
              {categoryProjects.map((project) => (
                <ProjectCard project={project} />
              ))}
            </ul>
          </section>
        ))
      )
    }
  </section>
</Layout>
