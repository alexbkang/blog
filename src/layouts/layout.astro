---
import '@/styles/global.css'
import '@/styles/typography.css'

import Footer from '@/components/footer.astro'
import Head from '@/components/head.astro'
import Header from '@/components/header.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!doctype html>
<html
  class="bg-background text-foreground scheme-light-dark"
  lang={SITE.locale}
>
  <Head>
    <slot name="head" />
  </Head>
  <body class="flex h-fit min-h-screen flex-col gap-y-6 font-sans">
    <header
      class="bg-background/50 sticky top-0 z-50 divide-y backdrop-blur-sm xl:divide-none"
    >
      <Header />
      <slot name="subposts-navigation" />
      <slot name="table-of-contents" />
    </header>
    <main
      class={cn('w-full mx-auto flex grow flex-col gap-y-6 px-4', className)}
    >
      <slot />
    </main>
    <Footer />
    <script>
      document.addEventListener('click', (event) => {
        const target = event.target
        if (!(target instanceof Element)) return

        const button = target.closest('button[data-filter]')
        if (!button) return

        const filterRoot = button.closest('[data-tag-filter]')
        const filterScope = button.closest('[data-filter-scope]') ?? document
        const itemsRoot = filterScope.querySelector('[data-filter-items]')
        if (!filterRoot || !itemsRoot) return

        const filter = button.getAttribute('data-filter')

        filterRoot.querySelectorAll('button[data-filter]').forEach((button) => {
          button.setAttribute(
            'data-active',
            String(button.getAttribute('data-filter') === filter),
          )
        })

        itemsRoot.querySelectorAll('[data-tags]').forEach((item) => {
          const tags = item.getAttribute('data-tags')?.split('|') ?? []
          item.toggleAttribute(
            'hidden',
            filter !== 'all' && !tags.includes(filter ?? ''),
          )
        })
      })
    </script>
  </body>
</html>
