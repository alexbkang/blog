---
import type { CollectionEntry } from 'astro:content'
import Link from './link.astro'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const { collection, data, id } = entry
const isoDate = data.date.toISOString()
const displayDate = isoDate.slice(0, 10)
---

<Link
  href={`/${collection}/${id}`}
  class="group flex items-baseline gap-5 border-b py-2.5 max-[520px]:items-start max-[520px]:gap-2 max-[520px]:py-2"
>
  <time
    class="text-muted-foreground w-24 shrink-0 text-xs opacity-80 transition-opacity group-hover:opacity-100 max-[520px]:w-auto"
    datetime={isoDate}
  >
    {displayDate}
  </time>

  <span
    class="group-hover:text-primary flex-1 text-sm leading-snug transition-colors"
  >
    {data.title}
  </span>

  <span
    class="text-muted-foreground group-hover:text-primary text-xs opacity-0 transition-[color,opacity,transform] group-hover:translate-x-0.5 group-hover:opacity-100 max-[520px]:hidden"
  >
    &rarr;
  </span>
</Link>
