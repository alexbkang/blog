---
import { SITE } from '@/consts'
import { Icon } from 'astro-icon/components'
import Link from './link.astro'
---

<footer
  class="mx-auto mb-8 flex w-full max-w-3xl flex-col items-center justify-center gap-y-2 px-4 sm:mb-4 sm:flex-row sm:justify-between"
>
  <div class="flex flex-wrap items-center justify-center gap-x-2 text-center">
    <span class="text-muted-foreground text-sm">
      &copy; {new Date().getFullYear()} | {SITE.title}
    </span>
  </div>
  <div class="flex items-center gap-x-2">
    <Link
      href="/tags/"
      class="text-muted-foreground hover:text-primary inline-flex items-center gap-1.5 text-sm"
    >
      <Icon name="lucide:tags" class="size-3.5" />
      Tags
    </Link>
  </div>
</footer>
