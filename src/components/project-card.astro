---
import Link from '@/components/link.astro'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const year = project.data.startDate?.getFullYear()
const title = year ? `${project.data.name} — ${year}` : project.data.name
---

<li data-tags={project.data.tags.join('|')}>
  <Link
    href={project.data.link}
    class="hover:border-primary flex w-full flex-col overflow-hidden rounded-[10px] border transition-colors duration-300 ease-in-out sm:flex-row"
    external
  >
    <div
      class="bg-muted/60 h-40 w-full shrink-0 overflow-hidden sm:h-[110px] sm:w-40"
      aria-hidden="true"
    >
      {
        project.data.image && (
          <Image
            src={project.data.image}
            alt=""
            width={320}
            height={220}
            class="h-full w-full object-cover"
          />
        )
      }
    </div>

    <span class="flex min-w-0 flex-1 flex-col justify-center px-[18px] py-4">
      <span class="text-[15px] leading-[1.35] font-medium">{title}</span>
      <span class="text-muted-foreground text-[13px] leading-[1.65]">
        {project.data.description}
      </span>
    </span>
  </Link>
</li>
