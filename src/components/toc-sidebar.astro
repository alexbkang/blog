---
import type { TOCSection } from '@/lib/data-utils'
import { cn } from '@/lib/utils'

type Props = {
  sections: TOCSection[]
  currentPostId: string
}

const { sections, currentPostId } = Astro.props

const getHeadingIndent = (depth: number) => {
  const indentMap: Record<number, string> = {
    2: 'pl-4',
    3: 'pl-7',
    4: 'pl-10',
    5: 'pl-13',
    6: 'pl-16',
  }
  return indentMap[depth] || 'pl-4'
}
---

{
  sections.length > 0 && (
    <div
      id="toc-sidebar-container"
      class="sticky top-24 col-start-3 row-span-1 mr-auto ml-8 hidden h-fit max-h-[calc(100vh-8rem)] w-52 flex-col gap-3 xl:flex"
    >
      <span class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">
        On this page
      </span>
      <nav aria-label="Table of contents">
        <ul class="flex flex-col overflow-y-auto max-h-[calc(100vh-12rem)] border-l border-border/30">
          {sections.flatMap((section) =>
            section.headings.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  data-heading-link={heading.slug}
                  class={cn(
                    'toc-item block truncate -ml-px border-l-2 border-transparent py-1 pr-2 text-[13px] leading-snug text-muted-foreground transition-colors duration-150 hover:text-foreground',
                    getHeadingIndent(heading.depth),
                  )}
                >
                  {heading.text}
                </a>
              </li>
            )),
          )}
        </ul>
      </nav>
    </div>
  )
}

<script>
  const HEADER_OFFSET = 80

  class TOCState {
    links: NodeListOf<Element> = document.querySelectorAll(
      '[data-heading-link]',
    )
    activeId: string | null = null
    headings: HTMLElement[] = []

    reset() {
      this.links = document.querySelectorAll(
        '#toc-sidebar-container [data-heading-link]',
      )
      this.activeId = null
      this.headings = []
    }
  }

  const state = new TOCState()

  class TOCLinks {
    static update(activeId: string | null) {
      state.links.forEach((link) => {
        link.classList.remove(
          'border-primary',
          'text-foreground',
          'font-medium',
        )
      })

      if (activeId) {
        const activeLink = document.querySelector(
          `#toc-sidebar-container [data-heading-link="${activeId}"]`,
        )
        if (activeLink) {
          activeLink.classList.add(
            'border-primary',
            'text-foreground',
            'font-medium',
          )
        }
      }
    }
  }

  class TOCController {
    static handleScroll() {
      if (state.headings.length === 0) return

      let newActiveId: string | null = null
      for (const heading of state.headings) {
        if (heading.getBoundingClientRect().top < HEADER_OFFSET + 50) {
          newActiveId = heading.id
        }
      }

      if (!newActiveId && state.headings.length > 0) {
        newActiveId = state.headings[0].id
      }

      if (newActiveId !== state.activeId) {
        state.activeId = newActiveId
        TOCLinks.update(state.activeId)
      }
    }

    static handleResize() {
      state.headings = Array.from(
        document.querySelectorAll<HTMLElement>(
          '.prose h2, .prose h3, .prose h4, .prose h5, .prose h6',
        ),
      )
      this.handleScroll()
    }

    static init() {
      state.reset()
      state.headings = Array.from(
        document.querySelectorAll<HTMLElement>(
          '.prose h2, .prose h3, .prose h4, .prose h5, .prose h6',
        ),
      )

      if (state.headings.length === 0) return

      this.handleScroll()

      const options = { passive: true }
      window.addEventListener('scroll', this.handleScroll, options)
      window.addEventListener('resize', this.handleResize, options)
    }

    static cleanup() {
      window.removeEventListener('scroll', this.handleScroll)
      window.removeEventListener('resize', this.handleResize)
      state.activeId = null
      state.headings = []
    }
  }

  document.addEventListener('astro:page-load', () => TOCController.init())
  document.addEventListener('astro:after-swap', () => {
    TOCController.cleanup()
    TOCController.init()
  })
  document.addEventListener('astro:before-swap', () => TOCController.cleanup())
</script>
